# ==============================================================================
# Content-Engine Configuration Example
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Application Execution Mode
# Options: "once" (single run then exit), "schedule" (recurring cron execution)
RUN_MODE=once

# Scheduler Configuration (used when RUN_MODE=schedule)
# Standard 5-field cron format: minute hour day-of-month month day-of-week
CRON_SCHEDULE="0 */6 * * *"
# Explicit IANA Timezone name, e.g. "UTC", "America/New_York", "Asia/Kolkata"
CRON_TIMEZONE="UTC"

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Content Brief Generation)
# ------------------------------------------------------------------------------
# Options: "gemini" (recommended), "mock" (offline testing)
LLM_PROVIDER=gemini
# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini Model name (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
# Seed prompt or topic theme for generating content briefs
CONTENT_TOPIC_PROMPT="Create a captivating, high-energy 10-second tech / AI micro-fact video suitable for social reels and shorts."

# ------------------------------------------------------------------------------
# Video Generation Provider Configuration
# ------------------------------------------------------------------------------
# Options: "gemini" (Google Veo/Gemini video), "luma" (Luma Dream Machine), "mock" (offline simulator)
VIDEO_PROVIDER=mock
# API Key for video generation provider
VIDEO_API_KEY=your-video-provider-api-key
# Model name if applicable
VIDEO_MODEL=veo-2.0-generate-001
# Polling interval for asynchronous video generation jobs (e.g. 10s, 15s)
VIDEO_POLL_INTERVAL=10s
# Maximum timeout to wait for video generation job completion
VIDEO_MAX_WAIT=10m

# ------------------------------------------------------------------------------
# Storage Provider Configuration
# ------------------------------------------------------------------------------
# Options: "local" (saves to local disk), "gdrive" (Google Drive API), "mock"
STORAGE_PROVIDER=local
# Local storage output directory (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR="data/videos"
# Path to Google Cloud Service Account credentials JSON file (used when STORAGE_PROVIDER=gdrive)
GDRIVE_CREDENTIALS_FILE=credentials.json
# Google Drive destination folder ID (found in Google Drive URL: drive.google.com/drive/folders/<FOLDER_ID>)
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# ------------------------------------------------------------------------------
# Database / Run History Persistence
# ------------------------------------------------------------------------------
# Options: "sqlite" (default embedded database), "postgres" (PostgreSQL), "jsonl" (append-only file)
DB_TYPE=sqlite
# SQLite database file path (when DB_TYPE=sqlite)
SQLITE_PATH="data/runs.db"
# PostgreSQL connection string (when DB_TYPE=postgres)
# DATABASE_URL="postgres://user:password@localhost:5432/content_engine?sslmode=disable"
# JSONL file path (when DB_TYPE=jsonl)
JSONL_PATH="data/runs.jsonl"

# ------------------------------------------------------------------------------
# Reliability, Timeouts & Retries
# ------------------------------------------------------------------------------
# Global HTTP client request timeout
HTTP_TIMEOUT=60s
# Maximum retry attempts for transient network or 5xx/429 HTTP errors
MAX_RETRIES=3
# Initial backoff duration before first retry
RETRY_INITIAL_INTERVAL=2s
# Maximum backoff duration between retries
RETRY_MAX_INTERVAL=30s
# Temporary working directory for downloading videos before upload
TMP_DIR=tmp
# Grace period to allow active video jobs to finish during graceful shutdown
SHUTDOWN_GRACE_PERIOD=30s

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
# Log level: "debug", "info", "warn", "error"
LOG_LEVEL=info
# Log format: "text" (human readable console) or "json" (structured production logs)
LOG_FORMAT=text
